# mistral-bridge env 配置示例(全部可选,零配置可跑)
# 复制为 .env 后按需启用;bridge 不持有任何 key(下游 Authorization 原样透传)。

# 监听地址(默认 :8080)
#LISTEN_ADDR=:8080

# 上游基址(默认 https://api.mistral.ai)
#UPSTREAM_BASE=https://api.mistral.ai

# 上游整体读超时秒数(默认 600,非流式可能 >480s 静默)
#UPSTREAM_TIMEOUT_S=600

# 默认注入的内置工具(逗号分隔;中文输入法宽容:全角逗号/顿号/方括号/弯引号均可)。
# 合法值:web_search | web_search_premium | code_interpreter | image_generation
# 默认不注入(客户端 tools 带哪个就开哪个)
#BUILTIN_TOOLS=""

# 是否把历史 assistant 的 reasoning_content 回传为 thinking 块(默认 true;false 省 prompt tokens)
#PASS_REASONING=true

# 自定义代理(兼容 http(s)://、socks5://、裸 host:port;空=不用)
#PROXY=

# 系统代理开关:auto|off(默认 auto;off 时忽略 env/注册表代理)
#SYSTEM_PROXY=auto

# 日志:level=debug|info|warn|error,dir/console/file(默认 info/logs/true/true)
#LOG_LEVEL=info
#LOG_DIR=logs
#LOG_CONSOLE=true
#LOG_FILE=true

# 入站请求体硬上限为内置常量 256MB(不开放配置;超限 413)。
# 上游非流式响应读全上限 64MB;SSE idle watchdog 300s;
# 日志轮转 64MB×7 份×14 天(均为内置防护,不进配置面)。
